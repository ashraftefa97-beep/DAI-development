{
  "manifest_version": 3,
  "name": "DAI Side Browser",
  "version": "1.1.0",
  "description": "Dock real browser windows beside DAI and report connection/placement status.",
  "permissions": [
    "windows",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "https://ashraftefa97-beep.github.io/DAI-development/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://ashraftefa97-beep.github.io/DAI-development/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
